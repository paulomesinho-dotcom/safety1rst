# ─────────────────────────────────────────────────────────────────
# SafeSite — Variáveis de Ambiente PRODUÇÃO (VPS PTISP)
# Copiar para /var/www/safesite/.env.production no servidor
# ─────────────────────────────────────────────────────────────────

# ── Base de Dados ─────────────────────────────────────────────────
DATABASE_URL="postgresql://safesite:PASSWORD_AQUI@localhost:5432/safesite_db?schema=public"

# ── NextAuth.js ───────────────────────────────────────────────────
# Gera com: openssl rand -base64 32
NEXTAUTH_SECRET="GERAR_SECRET_SEGURO"
NEXTAUTH_URL="https://safety1rst.xispoli.eu"

# ── Google OAuth ──────────────────────────────────────────────────
# Redirect URI: https://safety1rst.xispoli.eu/api/auth/callback/google
GOOGLE_CLIENT_ID="OBTIDO_NO_GOOGLE_CLOUD_CONSOLE"
GOOGLE_CLIENT_SECRET="OBTIDO_NO_GOOGLE_CLOUD_CONSOLE"

# ── Microsoft / Azure AD ──────────────────────────────────────────
# Redirect URI: https://safety1rst.xispoli.eu/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID="OBTIDO_NO_AZURE_PORTAL"
AZURE_AD_CLIENT_SECRET="OBTIDO_NO_AZURE_PORTAL"
AZURE_AD_TENANT_ID="common"

# ── Node.js ───────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3000
